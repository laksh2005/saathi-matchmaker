# Optional. Set one of these to enable AI; Gemini is used if both are set.
# Without either, Saathi uses its built in explanation and intro templates.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: gemini-2.5-flash, or gpt-4o-mini with OpenAI).
AI_MODEL=
# Secret used to sign the matchmaker session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
